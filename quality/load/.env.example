# Staging-only k6 inputs. Do not commit real values.
LOAD_TEST_ENV=staging
ALLOW_STAGING_LOAD=false
LOAD_PROFILE=smoke
CONFIRM_STAGING_COST=false
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-anon-key
TEST_ACCESS_TOKEN=replace-with-short-lived-staging-user-token
WORKSPACE_ID=replace-with-staging-workspace-uuid
PUBLIC_HANDLE=replace-with-staging-public-handle
SERVICE_ID=replace-with-staging-service-uuid
BOOKING_WRITE_ENABLED=false
FINANCE_WRITE_ENABLED=false
